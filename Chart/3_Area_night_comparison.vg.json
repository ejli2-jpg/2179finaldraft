{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Domestic vs international visitor nights over time",
    "subtitle": "Annual visitor nights (millions) | Source: TRA NVS + IVS",
    "anchor": "start",
    "fontSize": 15,
    "subtitleFontSize": 11,
    "subtitleColor": "#666"
  },
  "width": 600,
  "height": 280,
  "data": {
    "url": "Data/visitor_nights_by_type.csv"
  },
  "layer": [
    {
      "mark": {
        "type": "area",
        "opacity": 0.72,
        "line": { "strokeWidth": 2 }
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "temporal",
          "title": "Year",
          "axis": { "labelFontSize": 11, "format": "%Y" }
        },
        "y": {
          "field": "nights_millions",
          "type": "quantitative",
          "title": "Visitor nights (millions)",
          "stack": null,
          "axis": {
            "labelFontSize": 10,
            "grid": true,
            "gridDash": [3, 3],
            "gridColor": "#e0e0e0"
          }
        },
        "color": {
          "field": "visitor_type",
          "type": "nominal",
          "title": "Visitor type",
          "scale": {
            "domain": ["Domestic", "International"],
            "range": ["#D85A30", "#185FA5"]
          },
          "legend": null
        },
        "tooltip": [
          { "field": "year", "title": "Year", "type": "temporal", "format": "%Y" },
          { "field": "visitor_type", "title": "Type" },
          { "field": "nights_millions", "title": "Visitor nights (M)", "format": ".1f" }
        ]
      }
    },
    {
      "data": {
        "values": [
          { "x": "2020-03-01", "label": "Borders closed", "y": 420 },
          { "x": "2022-02-01", "label": "Borders reopened", "y": 420 }
        ]
      },
      "layer": [
        {
          "mark": {
            "type": "rule",
            "strokeDash": [4, 3],
            "strokeWidth": 1.5,
            "color": "#888"
          },
          "encoding": {
            "x": { "field": "x", "type": "temporal" }
          }
        },
        {
          "mark": {
            "type": "text",
            "align": "left",
            "dx": 5,
            "dy": 0,
            "fontSize": 10,
            "fontStyle": "italic",
            "color": "#222222"
          },
          "encoding": {
            "x": { "field": "x", "type": "temporal" },
            "y": { "field": "y", "type": "quantitative" },
            "text": { "field": "label" }
          }
        }
      ]
    },
    {
      "data": {
        "values": [
          { "x": "2016-06-01", "y": 455, "label": "▲ Pre-pandemic peak ~440M nights (2018)" }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "fontSize": 10,
        "fontStyle": "italic",
        "color": "#444444"
      },
      "encoding": {
        "x": { "field": "x", "type": "temporal" },
        "y": { "field": "y", "type": "quantitative" },
        "text": { "field": "label" }
      }
    },
    {
      "data": {
        "values": [
          { "x": "2017-01-01", "y": 330, "label": "Domestic" },
          { "x": "2017-01-01", "y": 110, "label": "International" }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": "bold",
        "align": "left"
      },
      "encoding": {
        "x": { "field": "x", "type": "temporal" },
        "y": { "field": "y", "type": "quantitative" },
        "text": { "field": "label" },
        "color": {
          "field": "label",
          "type": "nominal",
          "scale": {
            "domain": ["Domestic", "International"],
            "range": ["#D85A30", "#185FA5"]
          },
          "legend": null
        }
      }
    },
    {
      "data": {
        "values": [
          { "x": "2020-06-01", "y": 200, "label": "COVID-19 collapse:" },
          { "x": "2020-06-01", "y": 175, "label": "intl. arrivals near zero," },
          { "x": "2020-06-01", "y": 150, "label": "domestic travel sharply down" }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 6,
        "fontSize": 9.5,
        "fontStyle": "italic",
        "color": "#333333"
      },
      "encoding": {
        "x": { "field": "x", "type": "temporal" },
        "y": { "field": "y", "type": "quantitative" },
        "text": { "field": "label" }
      }
    },
    {
      "data": {
        "values": [
          { "x": "2023-01-01", "y": 75, "label": "International recovery" },
          { "x": "2023-01-01", "y": 55, "label": "still below 2019 levels" }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 4,
        "fontSize": 9.5,
        "fontStyle": "italic",
        "color": "#0d3d6e"
      },
      "encoding": {
        "x": { "field": "x", "type": "temporal" },
        "y": { "field": "y", "type": "quantitative" },
        "text": { "field": "label" }
      }
    }
  ],
  "config": {
    "view": { "stroke": null },
    "axis": { "domain": false, "ticks": false }
  }
}
