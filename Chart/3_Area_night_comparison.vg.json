{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Domestic visitor spend by capital city",
    "subtitle": "Bubble size = total spend ($B AUD) | Source: TRA National Visitor Survey, Dec 2024",
    "anchor": "start",
    "fontSize": 15,
    "subtitleFontSize": 11,
    "subtitleColor": "#666"
  },
  "width": 600,
  "height": 500,
  "projection": { "type": "mercator" },
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/rowanhogan/australian-states/master/states.geojson",
        "format": { "type": "json", "property": "features" }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#d8e8d0",
        "stroke": "#ffffff",
        "strokeWidth": 1.5
      }
    },
    {
      "data": {
        "url": "Data/city_visitor_spend.csv"
      },
      "mark": {
        "type": "circle",
        "opacity": 0.82,
        "stroke": "#ffffff",
        "strokeWidth": 1.5,
        "color": "#D85A30"
      },
      "encoding": {
        "longitude": { "field": "longitude", "type": "quantitative" },
        "latitude":  { "field": "latitude",  "type": "quantitative" },
        "size": {
          "field": "spend_billion_aud",
          "type": "quantitative",
          "title": "Spend ($B AUD)",
          "scale": { "range": [80, 8000] },
          "legend": {
            "orient": "right",
            "titleFontSize": 11,
            "labelFontSize": 10,
            "values": [0, 5, 10, 15, 20, 25, 30]
          }
        },
        "tooltip": [
          { "field": "city",             "title": "City" },
          { "field": "spend_billion_aud","title": "Visitor spend ($B AUD)", "format": ".1f" }
        ]
      }
    },
    {
      "data": {
        "url": "Data/city_visitor_spend.csv"
      },
      "mark": {
        "type": "text",
        "fontWeight": "bold",
        "fontSize": 11,
        "color": "#1a1a1a",
        "dy": -18
      },
      "encoding": {
        "longitude": { "field": "longitude", "type": "quantitative" },
        "latitude":  { "field": "latitude",  "type": "quantitative" },
        "text":      { "field": "city" }
      }
    },
    {
      "data": {
        "values": [
          {
            "longitude": 151.8,
            "latitude": -32.2,
            "label": "Sydney leads all cities —\nhighest spend driven by\ninternational visitors"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "fontSize": 10,
        "fontStyle": "italic",
        "color": "#D85A30",
        "lineBreak": "\n"
      },
      "encoding": {
        "longitude": { "field": "longitude", "type": "quantitative" },
        "latitude":  { "field": "latitude",  "type": "quantitative" },
        "text":      { "field": "label" }
      }
    },
    {
      "data": {
        "values": [
          {
            "longitude": 146.5,
            "latitude": -39.2,
            "label": "Melbourne: high trip\nvolume but lower total\nspend than Sydney"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "fontSize": 10,
        "fontStyle": "italic",
        "color": "#185FA5",
        "lineBreak": "\n"
      },
      "encoding": {
        "longitude": { "field": "longitude", "type": "quantitative" },
        "latitude":  { "field": "latitude",  "type": "quantitative" },
        "text":      { "field": "label" }
      }
    },
    {
      "data": {
        "values": [
          {
            "longitude": 122.5,
            "latitude": -32.5,
            "label": "Perth isolated by\ndistance; smaller\nvisitor base"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "fontSize": 10,
        "fontStyle": "italic",
        "color": "#666",
        "lineBreak": "\n"
      },
      "encoding": {
        "longitude": { "field": "longitude", "type": "quantitative" },
        "latitude":  { "field": "latitude",  "type": "quantitative" },
        "text":      { "field": "label" }
      }
    },
    {
      "data": {
        "values": [
          {
            "longitude": 138.3,
            "latitude": -26.8,
            "label": "Darwin & Hobart:\nsmallest capitals,\nsmallest visitor spend"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "fontSize": 10,
        "fontStyle": "italic",
        "color": "#666",
        "lineBreak": "\n"
      },
      "encoding": {
        "longitude": { "field": "longitude", "type": "quantitative" },
        "latitude":  { "field": "latitude",  "type": "quantitative" },
        "text":      { "field": "label" }
      }
    }
  ],
  "config": {
    "view": { "stroke": null },
    "axis": { "domain": false, "ticks": false }
  }
}
