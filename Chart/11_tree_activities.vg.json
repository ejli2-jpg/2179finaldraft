{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "Hierarchical tree of visitor activities",
  "width": 600,
  "height": 500,
  "padding": { "left": 10, "right": 200, "top": 60, "bottom": 20 },
  "title": {
    "text": "What international visitors do in Australia",
    "subtitle": "Participation rate by activity category | Source: TRA IVS, Dec 2024",
    "anchor": "start",
    "fontSize": 15,
    "subtitleFontSize": 11,
    "subtitleColor": "#666",
    "offset": 12
  },
  "data": [
    {
      "name": "tree",
      "url": "Data/visitor_activities_tree.csv",
      "format": { "type": "csv" },
      "transform": [
        { "type": "stratify", "key": "id", "parentKey": "parent" },
        {
          "type": "tree",
          "method": "tidy",
          "size": [{ "signal": "height" }, { "signal": "width - 200" }],
          "separation": false,
          "as": ["y", "x", "depth", "children"]
        }
      ]
    },
    {
      "name": "links",
      "source": "tree",
      "transform": [
        { "type": "treelinks" },
        { "type": "linkpath", "orient": "horizontal", "shape": "diagonal" }
      ]
    }
  ],
  "scales": [
    {
      "name": "color",
      "type": "ordinal",
      "domain": ["root", "Nature & Outdoors", "Food & Drink", "Culture & Heritage", "Shopping & Entertainment"],
      "range": ["#1D9E75", "#1D9E75", "#D85A30", "#7F77DD", "#185FA5"]
    },
    {
      "name": "leaf_size",
      "type": "linear",
      "domain": [0, 75],
      "range": [30, 280]
    }
  ],
  "marks": [
    {
      "type": "path",
      "from": { "data": "links" },
      "encode": {
        "update": {
          "path":          { "field": "path" },
          "stroke":        { "value": "#cccccc" },
          "strokeWidth":   { "value": 1 },
          "strokeOpacity": { "value": 0.7 }
        }
      }
    },
    {
      "type": "symbol",
      "from": { "data": "tree" },
      "encode": {
        "enter": {
          "x":           { "field": "x" },
          "y":           { "field": "y" },
          "size": {
            "signal": "datum.children ? 180 : scale('leaf_size', datum.participation_pct || 30)"
          },
          "fill":        { "scale": "color", "field": "category" },
          "fillOpacity": { "value": 0.75 },
          "stroke":      { "value": "#ffffff" },
          "strokeWidth": { "value": 1.5 },
          "tooltip": {
            "signal": "datum.children ? {'Category': datum.name} : {'Activity': datum.name, 'Category': datum.category, '% of visitors': datum.participation_pct + '%'}"
          }
        }
      }
    },
    {
      "type": "text",
      "from": { "data": "tree" },
      "encode": {
        "enter": {
          "x":        { "field": "x" },
          "y":        { "field": "y" },
          "dx":       { "signal": "datum.children ? -8 : 10" },
          "align":    { "signal": "datum.children ? 'right' : 'left'" },
          "baseline": { "value": "middle" },
          "text":     { "signal": "datum.children ? datum.name : datum.name + ' (' + datum.participation_pct + '%)'" },
          "fontSize": { "value": 10 },
          "fill":     { "value": "#333333" }
        }
      }
    },
    {
      "type": "rect",
      "encode": {
        "enter": {
          "x":            { "value": 420 },
          "y":            { "value": 360 },
          "width":        { "value": 220 },
          "height":       { "value": 145 },
          "fill":         { "value": "#f9f8f6" },
          "stroke":       { "value": "#e0ddd8" },
          "strokeWidth":  { "value": 1 },
          "cornerRadius": { "value": 4 }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "enter": {
          "x":          { "value": 430 },
          "y":          { "value": 375 },
          "text":       { "value": "Key insights" },
          "fontSize":   { "value": 10 },
          "fontWeight": { "value": "bold" },
          "fill":       { "value": "#333" }
        }
      }
    },
    {
      "type": "rule",
      "encode": {
        "enter": {
          "x":           { "value": 430 },
          "x2":          { "value": 630 },
          "y":           { "value": 383 },
          "stroke":      { "value": "#e0ddd8" },
          "strokeWidth": { "value": 1 }
        }
      }
    },
    {
      "type": "symbol",
      "encode": {
        "enter": {
          "x":    { "value": 438 },
          "y":    { "value": 397 },
          "size": { "value": 60 },
          "fill": { "value": "#D85A30" },
          "shape": { "value": "circle" }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "enter": {
          "x":          { "value": 450 },
          "y":          { "value": 393 },
          "text":       { "value": "Restaurants: 71% participation" },
          "fontSize":   { "value": 9.5 },
          "fontWeight": { "value": "bold" },
          "fill":       { "value": "#D85A30" },
          "baseline":   { "value": "top" }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "enter": {
          "x":         { "value": 450 },
          "y":         { "value": 407 },
          "text":      { "value": "Most common activity overall" },
          "fontSize":  { "value": 9 },
          "fontStyle": { "value": "italic" },
          "fill":      { "value": "#666" },
          "baseline":  { "value": "top" }
        }
      }
    },
    {
      "type": "symbol",
      "encode": {
        "enter": {
          "x":    { "value": 438 },
          "y":    { "value": 428 },
          "size": { "value": 60 },
          "fill": { "value": "#1D9E75" },
          "shape": { "value": "circle" }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "enter": {
          "x":          { "value": 450 },
          "y":          { "value": 424 },
          "text":       { "value": "Beach: 42% — top nature activity" },
          "fontSize":   { "value": 9.5 },
          "fontWeight": { "value": "bold" },
          "fill":       { "value": "#1D9E75" },
          "baseline":   { "value": "top" }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "enter": {
          "x":         { "value": 450 },
          "y":         { "value": 438 },
          "text":      { "value": "Australia's natural brand drives visits" },
          "fontSize":  { "value": 9 },
          "fontStyle": { "value": "italic" },
          "fill":      { "value": "#666" },
          "baseline":  { "value": "top" }
        }
      }
    },
    {
      "type": "symbol",
      "encode": {
        "enter": {
          "x":    { "value": 438 },
          "y":    { "value": 460 },
          "size": { "value": 60 },
          "fill": { "value": "#185FA5" },
          "shape": { "value": "circle" }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "enter": {
          "x":          { "value": 450 },
          "y":          { "value": 456 },
          "text":       { "value": "Shopping malls: 65% participation" },
          "fontSize":   { "value": 9.5 },
          "fontWeight": { "value": "bold" },
          "fill":       { "value": "#185FA5" },
          "baseline":   { "value": "top" }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "enter": {
          "x":         { "value": 450 },
          "y":         { "value": 470 },
          "text":      { "value": "Retail a major driver of visitor spend" },
          "fontSize":  { "value": 9 },
          "fontStyle": { "value": "italic" },
          "fill":      { "value": "#666" },
          "baseline":  { "value": "top" }
        }
      }
    }
  ]
}
