{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Domestic visitor spend by capital city",
    "subtitle": "Bubble size = total spend ($B AUD) | Source: TRA National Visitor Survey, Dec 2024",
    "anchor": "start",
    "fontSize": 15,
    "subtitleFontSize": 11,
    "subtitleColor": "#666"
  },
  "width": 700,
  "height": 450,
  "projection": {"type": "mercator", "center": [133, -28], "scale": 620},
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/ejli2-jpg/2179finaldraft/refs/heads/main/Data/au-states-topo.json",
        "format": {"type": "topojson", "feature": "states"}
      },
      "mark": {
        "type": "geoshape",
        "fill": "#d6e8d6",
        "stroke": "#ffffff",
        "strokeWidth": 1.2
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/ejli2-jpg/2179finaldraft/refs/heads/main/Data/spend_by_city.csv"
      },
      "mark": {
        "type": "circle",
        "opacity": 0.82,
        "color": "#D85A30",
        "stroke": "#ffffff",
        "strokeWidth": 1.5
      },
      "encoding": {
        "longitude": {"field": "longitude", "type": "quantitative"},
        "latitude": {"field": "latitude", "type": "quantitative"},
        "size": {
          "field": "spend_billion_aud",
          "type": "quantitative",
          "title": "Spend ($B AUD)",
          "scale": {"range": [150, 3800]},
          "legend": {
            "orient": "bottom-right",
            "titleFontSize": 11,
            "labelFontSize": 10,
            "title": "Spend ($B AUD)"
          }
        },
        "tooltip": [
          {"field": "city", "title": "City"},
          {"field": "state", "title": "State"},
          {"field": "spend_billion_aud", "title": "Domestic spend ($B AUD)", "format": ".2f"},
          {"field": "trips_millions", "title": "Overnight trips (M)", "format": ".1f"}
        ]
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/ejli2-jpg/2179finaldraft/refs/heads/main/Data/spend_by_city.csv"
      },
      "mark": {
        "type": "text",
        "dy": -18,
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#222222"
      },
      "encoding": {
        "longitude": {"field": "longitude", "type": "quantitative"},
        "latitude": {"field": "latitude", "type": "quantitative"},
        "text": {"field": "city", "type": "nominal"}
      }
    },
    {
      "data": {
        "values": [
          {"longitude": 119.0, "latitude": -19.5, "label": "Sydney leads all cities — highest spend"},
          {"longitude": 119.0, "latitude": -21.0, "label": "boosted by international visitors"}
        ]
      },
      "mark": {"type": "text", "align": "left", "fontSize": 10, "fontStyle": "italic", "color": "#D85A30"},
      "encoding": {
        "longitude": {"field": "longitude", "type": "quantitative"},
        "latitude": {"field": "latitude", "type": "quantitative"},
        "text": {"field": "label"}
      }
    },
    {
      "data": {
        "values": [
          {"longitude": 119.0, "latitude": -23.0, "label": "Melbourne: similar trip volume to Sydney"},
          {"longitude": 119.0, "latitude": -24.5, "label": "but lower total spend — fewer intl. visitors"}
        ]
      },
      "mark": {"type": "text", "align": "left", "fontSize": 10, "fontStyle": "italic", "color": "#555555"},
      "encoding": {
        "longitude": {"field": "longitude", "type": "quantitative"},
        "latitude": {"field": "latitude", "type": "quantitative"},
        "text": {"field": "label"}
      }
    },
    {
      "data": {
        "values": [
          {"longitude": 119.0, "latitude": -27.0, "label": "Perth: geographic isolation limits"},
          {"longitude": 119.0, "latitude": -28.5, "label": "visitor reach despite state size"}
        ]
      },
      "mark": {"type": "text", "align": "left", "fontSize": 10, "fontStyle": "italic", "color": "#555555"},
      "encoding": {
        "longitude": {"field": "longitude", "type": "quantitative"},
        "latitude": {"field": "latitude", "type": "quantitative"},
        "text": {"field": "label"}
      }
    },
    {
      "data": {
        "values": [
          {"longitude": 119.0, "latitude": -31.0, "label": "Darwin & Hobart: smallest capitals,"},
          {"longitude": 119.0, "latitude": -32.5, "label": "smallest visitor spend nationally"}
        ]
      },
      "mark": {"type": "text", "align": "left", "fontSize": 10, "fontStyle": "italic", "color": "#555555"},
      "encoding": {
        "longitude": {"field": "longitude", "type": "quantitative"},
        "latitude": {"field": "latitude", "type": "quantitative"},
        "text": {"field": "label"}
      }
    }
  ],
  "config": {"view": {"stroke": null}, "background": "#c9dde8"}
}
