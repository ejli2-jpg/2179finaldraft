{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "When do international visitors arrive? Monthly seasonality",
    "subtitle": "Visitor arrivals (thousands) by month and year | Source: ABS Overseas Arrivals and Departures",
    "anchor": "start", "fontSize": 15, "subtitleFontSize": 11, "subtitleColor": "#666"
  },
  "width": 560,
  "height": 500,
  "data": { "url": "Data/monthly_arrivals.csv" },
  "layer": [
    {
      "mark": { "type": "rect" },
      "encoding": {
        "x": {
          "field": "year", "type": "ordinal",
          "title": "Year",
          "axis": { "labelFontSize": 11, "labelAngle": -30 }
        },
        "y": {
          "field": "month", "type": "ordinal",
          "title": null,
          "sort": ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"],
          "axis": { "labelFontSize": 11 }
        },
        "color": {
          "field": "arrivals_thousands", "type": "quantitative",
          "title": "Arrivals (thousands)",
          "scale": {
            "range": ["#f5f0eb", "#e8c9a0", "#D85A30", "#8B1A00"],
            "domainMin": 0
          },
          "legend": { "orient": "right", "titleFontSize": 11, "labelFontSize": 10, "gradientLength": 200 }
        },
        "tooltip": [
          { "field": "month",              "title": "Month" },
          { "field": "year",               "title": "Year" },
          { "field": "arrivals_thousands", "title": "Arrivals (thousands)", "format": ",.0f" }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 9.5,
        "fontWeight": "bold",
        "color": "white",
        "align": "center",
        "baseline": "middle"
      },
      "transform": [
        { "filter": "(datum.month === 'Dec' || datum.month === 'Mar') && datum.year === '2024'" }
      ],
      "encoding": {
        "x": { "field": "year", "type": "ordinal" },
        "y": {
          "field": "month", "type": "ordinal",
          "sort": ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"]
        },
        "text": {
          "condition": [
            { "test": "datum.month === 'Dec'", "value": "Peak" },
            { "test": "datum.month === 'Mar'", "value": "Peak" }
          ],
          "value": ""
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 9.5,
        "fontWeight": "bold",
        "color": "#333",
        "align": "center",
        "baseline": "middle"
      },
      "transform": [
        { "filter": "datum.month === 'Jun' && datum.year === '2022'" }
      ],
      "encoding": {
        "x": { "field": "year", "type": "ordinal" },
        "y": {
          "field": "month", "type": "ordinal",
          "sort": ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"]
        },
        "text": { "value": "Low" }
      }
    },
    {
      "data": {
        "values": [
          { "year": "2022", "month": "Feb", "label": "Borders reopened Feb 2022" }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 9,
        "fontStyle": "italic",
        "color": "#333",
        "align": "center",
        "baseline": "middle"
      },
      "encoding": {
        "x": { "field": "year", "type": "ordinal" },
        "y": {
          "field": "month", "type": "ordinal",
          "sort": ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"]
        },
        "text": { "field": "label" }
      }
    },
    {
      "data": {
        "values": [
          { "year": "2024", "month": "May", "label": "2024 matches 2019" }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 9,
        "fontStyle": "italic",
        "color": "#fff",
        "align": "center",
        "baseline": "middle"
      },
      "encoding": {
        "x": { "field": "year", "type": "ordinal" },
        "y": {
          "field": "month", "type": "ordinal",
          "sort": ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"]
        },
        "text": { "field": "label" }
      }
    }
  ],
  "config": {
    "view": { "stroke": null },
    "axis": { "domain": false, "ticks": false }
  }
}
